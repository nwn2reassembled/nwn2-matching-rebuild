# Copy to .env (ignored). Never commit keys or paste them into issues.
PROVIDER=deepseek
MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# Or use PROVIDER=openai / anthropic with an explicit available model:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
MAX_TOKENS=4096
TASK_ID=rules-03a90
# Confirm you reviewed the input licenses and may use these files:
ACCEPT_INPUT_LICENSES=no
# Disassembly of the selected function will be sent to the chosen provider:
SEND_REFERENCE_TO_PROVIDER=no
